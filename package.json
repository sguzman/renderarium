{
  "name": "renderarium",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Public SC3D renderer and canonical chat-preview verification mirror",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.15.1",
  "scripts": {
    "verify:public-boundary": "node tools/publication-gate.mjs",
